---
import ComponentsMarquee from '@/components/sections/components-marquee.astro'
import { Hero } from '@/components/sections/hero'

import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { AnimatedThemeToggler } from '@/registry/magicui/animated-theme-toggler.tsx'
import 'starlight-theme-black/styles/layers'
import 'starlight-theme-black/styles/theme'
import 'starlight-theme-black/styles/base'
import '@/styles/global.css'
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>MagicUI Solid — Animated UI components for SolidJS</title>
    <meta
      name="description"
      content="Animated UI components for SolidJS, ported from Magic UI."
    />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script is:inline>
    ;(() => {
      const stored = localStorage.getItem('starlight-theme')
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark'
    })()
    </script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <div
      class="
        pointer-events-none absolute inset-0 z-0 h-24 w-full
        before:absolute before:-bottom-1/5 before:left-1/2 before:z-0
        before:h-4/5 before:w-3/5 before:-translate-x-1/2 before:animate-rainbow
        before:bg-[linear-gradient(90deg,var(--color-1),var(--color-5),var(--color-3),var(--color-4),var(--color-2))]
        before:bg-size-[200%] before:opacity-20 before:filter-[blur(4rem)]
      "
    />
    <header
      class="
        sticky top-0 z-50 border-b border-border/50 bg-background/80
        backdrop-blur-sm
      "
    >
      <div
        class="
          mx-auto flex h-14 max-w-6xl items-center justify-between px-4
          md:px-6
        "
      >
        <a
          href={import.meta.env.BASE_URL}
          class="flex items-center gap-2 text-sm font-semibold"
        >
          <img
            src={`${import.meta.env.BASE_URL}favicon.svg`}
            alt="MagicUI Solid"
            class="size-5 rounded-full"
          />
          MagicUI Solid
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a
            href={`${import.meta.env.BASE_URL}docs/`}
            class={cn(
              buttonVariants({ variant: 'ghost', size: 'sm' }),
              `
                text-muted-foreground
                hover:text-foreground
              `,
            )}
          >
            Introduction
          </a>
          <a
            href={`${import.meta.env.BASE_URL}docs/components/`}
            class={cn(
              buttonVariants({ variant: 'ghost', size: 'sm' }),
              `
                text-muted-foreground
                hover:text-foreground
              `,
            )}
          >
            Components
          </a>
          <a
            href="https://github.com/axuj/magicui-solid"
            target="_blank"
            rel="noreferrer"
            class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'ml-1')}
            aria-label="GitHub"
          >
            <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
          <AnimatedThemeToggler
            client:load
            class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'ml-1')}
          />
        </nav>
      </div>
    </header>

    <main>
      <div class="
        mx-auto max-w-6xl px-4
        md:px-6
      "
      >
        <Hero client:load />
        <ComponentsMarquee />
      </div>
    </main>

    <footer class="border-t border-border/50 py-8">
      <div class="
        mx-auto flex max-w-6xl items-center justify-between px-4 text-xs
        text-muted-foreground
        md:px-6
      "
      >
        <span>
          Built with Astro, SolidJS & Tailwind CSS. Ported from
          {' '}
          <a
            href="https://magicui.design"
            target="_blank"
            rel="noreferrer"
            class="
              underline-offset-4
              hover:underline
            "
          >
            Magic UI
          </a>
          .
        </span>
        <a
          href="https://github.com/axmol/magicui-solid"
          target="_blank"
          rel="noreferrer"
          class="
            underline-offset-4
            hover:underline
          "
        >
          GitHub
        </a>
      </div>
    </footer>
  </body>
</html>

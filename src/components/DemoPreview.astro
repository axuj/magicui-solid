---
import ComponentPreview from '@/components/ComponentPreview.astro'
import { DynamicPreview } from '@/components/DynamicPreview'
import { demoPaths, demoRawMap } from '@/demos/__generated__/demos'

export interface Props {
  demo: keyof typeof demoPaths
  align?: 'center' | 'start' | 'end'
  class?: string
}

const { demo, align, class: className } = Astro.props
const code = demoRawMap[demo]
const demoPath = demoPaths[demo]
const lang = demoPath?.endsWith('.tsx') ? 'tsx' : demoPath?.endsWith('.jsx') ? 'jsx' : 'tsx'
const meta = demoPath ? `title="${demoPath.replace('/src', '@')}"` : undefined
---

<ComponentPreview code={code} lang={lang} meta={meta} align={align} class={className}>
  <DynamicPreview demo={demo} align={align} client:load />
</ComponentPreview>


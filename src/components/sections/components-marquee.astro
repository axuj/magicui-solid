---
import { getCollection } from 'astro:content'
import { ComponentsMarquee } from '@/components/sections/components-marquee.tsx'

const components = (await getCollection('docs'))
  .filter(entry => entry.id.startsWith('docs/components/') && !entry.id.endsWith('/index'))
  .map(entry => ({
    title: entry.data.title,
    description: entry.data.description ?? '',
    href: `/${entry.id}`,
  }))
---

<div class="not-content">
  <ComponentsMarquee items={components} client:load />
</div>

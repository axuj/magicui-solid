{
  "name": "magicui-solid",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "nub scripts/build-registry.ts && nubx shadcn build __generated__/registry.json && astro build",
    "preview": "astro preview",
    "ts-check": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix --cache",
    "astro": "astro",
    "registry": "nub scripts/build-registry.ts && nubx shadcn build __generated__/registry.json && nub scripts/check-registry.ts",
    "check:registry": "nub scripts/check-registry.ts",
    "smoke": "nub scripts/smoke.ts",
    "smoke:preview": "nub scripts/smoke-preview.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@iconify-json/ri": "1.2.10",
    "@kobalte/core": "2.0.0-alpha.4",
    "@lucide/solid": "1.70.0",
    "@pagefind/default-ui": "1.5.2",
    "@shikijs/themes": "4.4.2",
    "@shikijs/transformers": "4.4.2",
    "@shikijs/types": "4.4.2",
    "@solid-primitives/spring": "1.0.0-next.5",
    "@solidjs/babel-plugin": "2.0.0-rc.21",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.21",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "astro-solid-next": "0.1.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cobe": "0.6.5",
    "countries-list": "3.4.1",
    "motion": "12.43.0",
    "rough-notation": "0.5.1",
    "shiki": "4.4.2",
    "solid-js": "2.0.0-rc.21",
    "starlight-theme-black": "0.7.1",
    "svg-dotted-map": "2.1.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/canvas-confetti": "1.9.0",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-solid": "0.19.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "shadcn": "4.16.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@solidjs/signals": "2.0.0-rc.21"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.2",
      "onFail": "warn"
    }
  }
